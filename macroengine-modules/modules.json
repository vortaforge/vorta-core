          "id": "me_container_module:container/addr",
          "wraps": "me_container_module:core/internal/container/_addr",
          "contract": "Resolve the address in storage macroengine:container tmp.k (x/y/z + optional slot). Returns 1 when it resolved, 0 otherwise."
        },
        {
          "id": "me_container_module:container/exists",
          "wraps": "me_container_module:core/internal/container/_exists",
          "contract": "Returns 1 when storage macroengine:container tmp.k names a block with an Items list, 0 otherwise. Does not touch macroengine:output."
        },
        {
          "id": "me_container_module:container/slot_at",
          "wraps": "me_container_module:core/internal/container/_ff_loop",
          "contract": "Return the next slot index at or after #ct_i in storage macroengine:container tmp.f, or -1 when the container is full. Macro function."
        },
        {
          "id": "me_container_module:container/find_first_free",
          "wraps": "me_container_module:core/internal/container/_size_pick",
          "contract": "Resolve the container size from storage macroengine:container tmp.k (honouring the `ovr` field) and store it in #ct_size macroengine.tmp. Returns 1 when a size in 1..256 was found, 0 otherwise."
        },
